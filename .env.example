# Database URL (SQLite default)
DATABASE_URL=sqlite:///data/finsight_ai.db

# Model configuration
MODEL_PATH=data/models/stock_model.joblib

# FinBERT Sentiment
NEWS_USE_FINBERT=false
NEWS_FINBERT_MODEL=ProsusAI/finbert

# News Provider (alphavantage / yahoo)
NEWS_PROVIDER=alphavantage

# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
